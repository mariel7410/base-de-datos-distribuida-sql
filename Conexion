using System;
using Oracle.ManagedDataAccess.Client;

namespace BD_Banco
{
    public class Conexion
    {
        private string Servidor1 = "IP_SERVIDOR_PRIMARIO"; // Servidor primario
        private string Servidor2 = "IP_SERVIDOR_SECUNDARIO"; // Servidor secundario
        private string Base1 = "orcl"; 
        private string Base2 = "orcl";
        private string Usuario = "USUARIO_BD";
        private string Clave = "PASSWORD_BD";

        // Método para crear la conexión
        public OracleConnection CrearConexion(bool usarServidorSecundario = false)
        {
            OracleConnection conexion = new OracleConnection();
            string connectionString = "";

            try
            {
                if (!usarServidorSecundario)
                {
                    connectionString = $@"
                        Data Source= 
                            (DESCRIPTION =
                                (ADDRESS_LIST =
                                    (ADDRESS = (PROTOCOL = TCP)(HOST = {this.Servidor1})(PORT = 1521))
                                )
                                (CONNECT_DATA =
                                    (SERVICE_NAME = {this.Base1})
                                )
                            );
                        User Id={this.Usuario}; 
                        Password={this.Clave};";
                }
                else
                {
                    connectionString = $@"
                        Data Source= 
                            (DESCRIPTION =
                                (ADDRESS_LIST =
                                    (ADDRESS = (PROTOCOL = TCP)(HOST = {this.Servidor2})(PORT = 1521))
                                )
                                (CONNECT_DATA =
                                    (SERVICE_NAME = {this.Base2})
                                )
                            );
                        User Id={this.Usuario}; 
                        Password={this.Clave};";
                }

                conexion.ConnectionString = connectionString;
                conexion.Open();
                Console.WriteLine("Conexión establecida correctamente");
            }
            catch (Exception ex)
            {
                conexion = null;
                Console.WriteLine($"Error de conexión: {ex.Message}");

                // Si no se pudo conectar al servidor primario, intentar al servidor secundario
                if (!usarServidorSecundario)
                {
                    Console.WriteLine("Intentando con el servidor secundario...");
                    return CrearConexion(true); // Intentar con el servidor secundario
                }

                // Si tampoco falla el secundario, lanzar la excepción
                throw new Exception("Error al intentar conectar con la base de datos", ex);
            }

            return conexion;
        }
    }
}
